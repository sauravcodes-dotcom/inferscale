{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferscale.example/schemas/triage_v1/label.json",
  "title": "triage_v1 label",
  "description": "Triage decision for one alert. See LABELING.md for field rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["severity", "component", "category", "needs_page", "summary"],
  "properties": {
    "severity": {"type": "string", "enum": ["SEV1", "SEV2", "SEV3", "SEV4"]},
    "component": {
      "type": "string",
      "enum": ["api-gateway", "auth-service", "payments", "database", "cache", "message-queue",
               "storage", "kubernetes", "cdn", "ci-cd", "dns", "unknown"]
    },
    "category": {
      "type": "string",
      "enum": ["resource_exhaustion", "network", "dependency", "config", "deploy_regression",
               "auth", "data", "unknown"]
    },
    "needs_page": {"type": "boolean"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
