# Engine profile: default (chat / short prompts). 8192 tokens total across 2 slots = 4096 per slot.
ENGINE_CTX=8192
ENGINE_PARALLEL=2
ENGINE_GPU_LAYERS=all
ENGINE_REASONING=off
# Host prompt cache (MiB). Off: on BFCL traffic it added 1-3 points of prompt reuse over in-slot
# prefix reuse (54%) and no measurable latency, for ~1.6 GB RSS at 1024 and 6.8 GB of swap at
# llama.cpp's 8192 default (reports/m43_findings.md, 2026-10-20).
ENGINE_CACHE_RAM=0
